# ==========================================
# API Configuration
# ==========================================
EXPO_PUBLIC_API_URL=http://localhost:3009

# App version — sent as X-App-Version header for backend version checks
EXPO_PUBLIC_APP_VERSION=0.0.0

# ==========================================
# Firebase Configuration
# Get these from: Firebase Console > Project Settings > Your apps > SDK setup
# ==========================================
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Landing page (web only - never affects the APK build)
EXPO_PUBLIC_LANDING_ENABLED=false
EXPO_PUBLIC_APK_URL=

# Web app (landing) URL
# Used by the update gate to send users to download the latest version
EXPO_PUBLIC_WEB_URL=
